// Stella Astrology — data model
//
// Phase 2 scope only. Astrologers are STATIC PAGE CONTENT in Phase 2 and
// become rows in Phase 4 — do not add an Astrologer model here yet.
//
// Two invariants this schema must eventually carry, recorded now so they are
// not discovered late:
//
//   1. SLOT UNIQUENESS (ADR-029). MySQL 8 has no partial unique indexes.
//      A plain @@unique([astrologerId, slotStart]) permanently blocks a slot
//      once a booking is cancelled. Use a stored generated column that is
//      NULL when the row is not slot-occupying — MySQL allows unlimited NULLs
//      in a unique index. Prisma cannot express this; it needs raw SQL in the
//      migration.
//
//   2. PRICE AND TAX SNAPSHOTS (ADR-023). Under pay-at-booking the invoice is
//      issued at booking, so the booking row must freeze price in paise AND
//      the tax breakdown at creation. Adding tax columns to already-paid rows
//      later is the uncorrectable retrofit the whole plan is ordered to avoid.
//
// Money is always integer paise. Never a float, never a Decimal string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")

  // Prisma diffs migrations in a throwaway shadow database. The app user has
  // no global CREATE privilege — correctly, it should not — so point Prisma at
  // a dedicated database rather than widening that grant.
  // Not needed in production: `migrate deploy` applies existing migrations and
  // never diffs, so this is only read in development.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Waitlist signups from the public landing page (Phase 2).
///
/// Email is required and phone optional (ADR-028): SMS needs TRAI DLT
/// registration, which has not started, so a phone-only lead would be
/// uncontactable.
///
/// The endpoint returns a byte-identical response whether or not the address
/// already exists — a distinct reply turns the form into an oracle for whether
/// a named person is a Stella customer. That fix requires double opt-in to be
/// safe, or anyone can squat an address and silently lock out its owner.
model Lead {
  id    String  @id @db.Char(26) // ULID
  email String  @unique @db.VarChar(320)
  phone String? @db.VarChar(16) // E.164, normalised before write

  locale       String  @default("hi") @db.VarChar(10)
  source       String? @db.VarChar(64)
  referralCode String? @map("referral_code") @db.VarChar(32)

  utmSource   String? @map("utm_source") @db.VarChar(128)
  utmMedium   String? @map("utm_medium") @db.VarChar(128)
  utmCampaign String? @map("utm_campaign") @db.VarChar(128)

  /// Consent is a stored artifact with a policy version, never a boolean.
  /// DPDP requires knowing what was agreed to, not merely that something was.
  consentAt            DateTime @map("consent_at")
  consentPolicyVersion String   @map("consent_policy_version") @db.VarChar(32)

  /// Double opt-in (ADR-028). A lead is not contactable until confirmed.
  confirmedAt       DateTime? @map("confirmed_at")
  confirmationToken String?   @unique @map("confirmation_token") @db.Char(43)

  /// Set when Turnstile was unreachable and the request was allowed through.
  /// Degrading open keeps signup alive during a bot-check outage; the flag is
  /// how those leads get reviewed later.
  turnstileBypassed Boolean @default(false) @map("turnstile_bypassed")

  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  /// Marks a development seed row (ADR-026). Present in the production schema
  /// permanently and deliberately: the boot guard cannot detect fixtures
  /// without a column to look at. Production rows are always false.
  isDevFixture Boolean @default(false) @map("is_dev_fixture")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([referralCode])
  @@index([isDevFixture])
  @@map("leads")
}

/// Append-only audit log (ADR: Phase 1 substrate).
///
/// Enforced append-only by GRANTs, not by convention: the application user
/// gets INSERT and SELECT, never UPDATE or DELETE. A log the app can rewrite
/// is not an audit log.
///
/// Every privileged action writes here. A write failure ABORTS the enclosing
/// transaction rather than logging quietly — a silent audit failure on the
/// surface built to prove the audit trail works is the worst possible outcome.
model AuditEvent {
  id String @id @db.Char(26)

  actorId   String? @map("actor_id") @db.Char(26)
  actorRole String? @map("actor_role") @db.VarChar(32)

  action     String  @db.VarChar(64)
  targetType String  @map("target_type") @db.VarChar(64)
  targetId   String? @map("target_id") @db.VarChar(64)

  /// Before/after state for mutations. Null for reads.
  before Json?
  after  Json?

  reason String? @db.Text

  ip        String?  @db.VarChar(45)
  sessionId String?  @map("session_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

/// Idempotency keys (ADR: Phase 1 substrate).
///
/// Needed by Razorpay webhooks and by booking creation. A double-click that
/// creates two Razorpay orders for one slot is the most likely launch
/// incident: the slot unique index protects the slot, not the customer's card.
model IdempotencyKey {
  key         String   @id @db.VarChar(255)
  scope       String   @db.VarChar(64)
  requestHash String   @map("request_hash") @db.Char(64)
  response    Json?
  status      String   @default("in_progress") @db.VarChar(24)
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox (ADR-030).
///
/// Cut once, citing per-minute billing — reasoning that inverted when the
/// model became pay-at-booking. A payment webhook must confirm the booking,
/// email the customer and notify the astrologer reliably; that is exactly the
/// at-least-once side-effect problem, now sitting on the money path.
model OutboxMessage {
  id          String    @id @db.Char(26)
  topic       String    @db.VarChar(64)
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processedAt, availableAt])
  @@map("outbox_messages")
}

/// A person who can sign in. One identity per human, carrying an additive set
/// of roles (ADR-018) — the same account can be both astrologer and admin, so
/// the audit trail can answer "who did this" without duplicate accounts.
///
/// Two sign-in paths, deliberately:
///   - Customers use Google (ADR-037). No password is stored for them, which is
///     the half of ADR-011 that still stands.
///   - The admin uses a password (ADR-038). ADR-011 always allowed "a future
///     password-based admin path"; this is it.
model User {
  id String @id @db.Char(26) // ULID

  /// Always present, and the key Google sign-in resolves to. Unique because two
  /// accounts for one address would fragment the audit trail.
  email String  @unique @db.VarChar(320)
  name  String? @db.VarChar(120)

  /// Google's stable subject id. Null for password-only accounts (the admin).
  /// Unique so one Google account cannot be attached to two users.
  googleSub String? @unique @map("google_sub") @db.VarChar(64)

  /// scrypt hash, "scrypt$N$r$p$salt$key" (node:crypto — no native dependency,
  /// and a real memory-hard KDF rather than a bare digest). Null for everyone
  /// except the admin: a password column that is usually null is the point,
  /// not an oversight.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// Additive roles as a JSON array of strings, e.g. ["admin:super"].
  /// MySQL has no array type and a join table for a handful of roles on a dozen
  /// users would cost more than it explains.
  roles Json

  /// Set when a human disables the account. Sessions are revoked separately —
  /// this is the durable fact, the session store is the fast path.
  disabledAt DateTime? @map("disabled_at")

  /// Consecutive failed password attempts, and the time a lockout expires.
  /// Password-only admin (ADR-038) makes brute-force the whole attack surface,
  /// so the counter is durable rather than in-memory: restarting the API must
  /// not clear a lockout.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@index([disabledAt])
  @@map("users")
}

/// Server-side sessions (ADR-039, plan 3.2).
///
/// The reason this table exists rather than a self-contained token: revocation.
/// A signed token is valid until it expires, so disabling an account would not
/// end a live session. Revocation has to be a lookup against something the
/// server can change, which means a row.
///
/// The cookie carries a random id; only its SHA-256 lands here, so a dump of
/// this table does not let anyone resume a session.
model Session {
  /// SHA-256 of the cookie value, hex. Never the cookie value itself.
  tokenHash String @id @map("token_hash") @db.Char(64)

  userId String @map("user_id") @db.Char(26)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Recorded to show a person their own sessions, and to make a stolen cookie
  /// visible in the audit trail.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  expiresAt  DateTime  @map("expires_at")
  /// Set when revoked. Kept rather than deleted so "when did this end, and why"
  /// stays answerable; the scheduler purges rows well past expiry.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
