// Stella Astrology — data model
//
// Phase 2 scope only. Astrologers are STATIC PAGE CONTENT in Phase 2 and
// become rows in Phase 4 — do not add an Astrologer model here yet.
//
// Two invariants this schema must eventually carry, recorded now so they are
// not discovered late:
//
//   1. SLOT UNIQUENESS (ADR-029). MySQL 8 has no partial unique indexes.
//      A plain @@unique([astrologerId, slotStart]) permanently blocks a slot
//      once a booking is cancelled. Use a stored generated column that is
//      NULL when the row is not slot-occupying — MySQL allows unlimited NULLs
//      in a unique index. Prisma cannot express this; it needs raw SQL in the
//      migration.
//
//   2. PRICE AND TAX SNAPSHOTS (ADR-023). Under pay-at-booking the invoice is
//      issued at booking, so the booking row must freeze price in paise AND
//      the tax breakdown at creation. Adding tax columns to already-paid rows
//      later is the uncorrectable retrofit the whole plan is ordered to avoid.
//
// Money is always integer paise. Never a float, never a Decimal string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")

  // Prisma diffs migrations in a throwaway shadow database. The app user has
  // no global CREATE privilege — correctly, it should not — so point Prisma at
  // a dedicated database rather than widening that grant.
  // Not needed in production: `migrate deploy` applies existing migrations and
  // never diffs, so this is only read in development.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Waitlist signups from the public landing page (Phase 2).
///
/// Email is required and phone optional (ADR-028): SMS needs TRAI DLT
/// registration, which has not started, so a phone-only lead would be
/// uncontactable.
///
/// The endpoint returns a byte-identical response whether or not the address
/// already exists — a distinct reply turns the form into an oracle for whether
/// a named person is a Stella customer. That fix requires double opt-in to be
/// safe, or anyone can squat an address and silently lock out its owner.
model Lead {
  id    String  @id @db.Char(26) // ULID
  email String  @unique @db.VarChar(320)
  phone String? @db.VarChar(16) // E.164, normalised before write

  locale       String  @default("hi") @db.VarChar(10)
  source       String? @db.VarChar(64)
  referralCode String? @map("referral_code") @db.VarChar(32)

  utmSource   String? @map("utm_source") @db.VarChar(128)
  utmMedium   String? @map("utm_medium") @db.VarChar(128)
  utmCampaign String? @map("utm_campaign") @db.VarChar(128)

  /// Consent is a stored artifact with a policy version, never a boolean.
  /// DPDP requires knowing what was agreed to, not merely that something was.
  consentAt            DateTime @map("consent_at")
  consentPolicyVersion String   @map("consent_policy_version") @db.VarChar(32)

  /// Double opt-in (ADR-028). A lead is not contactable until confirmed.
  confirmedAt       DateTime? @map("confirmed_at")
  confirmationToken String?   @unique @map("confirmation_token") @db.Char(43)

  /// Set when Turnstile was unreachable and the request was allowed through.
  /// Degrading open keeps signup alive during a bot-check outage; the flag is
  /// how those leads get reviewed later.
  turnstileBypassed Boolean @default(false) @map("turnstile_bypassed")

  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  /// Marks a development seed row (ADR-026). Present in the production schema
  /// permanently and deliberately: the boot guard cannot detect fixtures
  /// without a column to look at. Production rows are always false.
  isDevFixture Boolean @default(false) @map("is_dev_fixture")

  /// Which seed run created this row (ADR-036). Cleanup deletes by dataset, so
  /// a reseed can never reach a row it did not create — "delete where
  /// is_dev_fixture" would happily take someone else's fixtures with it.
  fixtureDataset String? @map("fixture_dataset") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  /// DPDP access and erasure requests made by this person (ADR-040).
  privacyRequests PrivacyRequest[]

  @@index([createdAt])
  @@index([referralCode])
  @@index([isDevFixture])
  @@map("leads")
}

/// A DPDP access or erasure request (ADR-040).
///
/// A lead has NO ACCOUNT, so the only way to authenticate one of these is to
/// prove control of the address — the same thing double opt-in already proves.
/// The emailed token is the proof; this row is its server-side half.
model PrivacyRequest {
  id String @id @db.Char(26) // ULID

  /// SHA-256 of the emailed token, hex. Never the token itself — the same rule
  /// as sessions: reading this table must not let anyone exercise a request.
  tokenHash String @unique @map("token_hash") @db.Char(64)

  /// The subject. CASCADE is load-bearing: erasing the lead must also remove
  /// the request that asked for it, or this table keeps a live pointer to a
  /// person who has been deleted.
  leadId String @map("lead_id") @db.Char(26)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// 'access' or 'erasure'. A VarChar rather than a Prisma enum to match the
  /// rest of this schema; the service validates it.
  kind String @db.VarChar(16)

  expiresAt   DateTime  @map("expires_at")
  /// Set when exercised. Single use — a link that still works after it has been
  /// used is a link that works for whoever later reads the mailbox.
  completedAt DateTime? @map("completed_at")

  /// Who asked, for the audit trail. Erased along with the row.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@index([expiresAt])
  @@map("privacy_requests")
}

/// Append-only audit log (ADR: Phase 1 substrate).
///
/// Enforced append-only by GRANTs, not by convention: the application user
/// gets INSERT and SELECT, never UPDATE or DELETE. A log the app can rewrite
/// is not an audit log.
///
/// Every privileged action writes here. A write failure ABORTS the enclosing
/// transaction rather than logging quietly — a silent audit failure on the
/// surface built to prove the audit trail works is the worst possible outcome.
model AuditEvent {
  id String @id @db.Char(26)

  actorId   String? @map("actor_id") @db.Char(26)
  actorRole String? @map("actor_role") @db.VarChar(32)

  action     String  @db.VarChar(64)
  targetType String  @map("target_type") @db.VarChar(64)
  targetId   String? @map("target_id") @db.VarChar(64)

  /// Before/after state for mutations. Null for reads.
  before Json?
  after  Json?

  reason String? @db.Text

  ip        String?  @db.VarChar(45)
  sessionId String?  @map("session_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

/// Idempotency keys (ADR: Phase 1 substrate).
///
/// Needed by Razorpay webhooks and by booking creation. A double-click that
/// creates two Razorpay orders for one slot is the most likely launch
/// incident: the slot unique index protects the slot, not the customer's card.
model IdempotencyKey {
  key         String   @id @db.VarChar(255)
  scope       String   @db.VarChar(64)
  requestHash String   @map("request_hash") @db.Char(64)
  response    Json?
  status      String   @default("in_progress") @db.VarChar(24)
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox (ADR-030).
///
/// Cut once, citing per-minute billing — reasoning that inverted when the
/// model became pay-at-booking. A payment webhook must confirm the booking,
/// email the customer and notify the astrologer reliably; that is exactly the
/// at-least-once side-effect problem, now sitting on the money path.
model OutboxMessage {
  id          String    @id @db.Char(26)
  topic       String    @db.VarChar(64)
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processedAt, availableAt])
  @@map("outbox_messages")
}

/// A person who can sign in. One identity per human, carrying an additive set
/// of roles (ADR-018) — the same account can be both astrologer and admin, so
/// the audit trail can answer "who did this" without duplicate accounts.
///
/// Two sign-in paths, deliberately:
///   - Customers use Google (ADR-037). No password is stored for them, which is
///     the half of ADR-011 that still stands.
///   - The admin uses a password (ADR-038). ADR-011 always allowed "a future
///     password-based admin path"; this is it.
model User {
  id String @id @db.Char(26) // ULID

  /// Always present, and the key Google sign-in resolves to. Unique because two
  /// accounts for one address would fragment the audit trail.
  email String  @unique @db.VarChar(320)
  name  String? @db.VarChar(120)

  /// Google's stable subject id. Null for password-only accounts (the admin).
  /// Unique so one Google account cannot be attached to two users.
  googleSub String? @unique @map("google_sub") @db.VarChar(64)

  /// scrypt hash, "scrypt$N$r$p$salt$key" (node:crypto — no native dependency,
  /// and a real memory-hard KDF rather than a bare digest). Null for everyone
  /// except the admin: a password column that is usually null is the point,
  /// not an oversight.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// Additive roles as a JSON array of strings, e.g. ["admin:super"].
  /// MySQL has no array type and a join table for a handful of roles on a dozen
  /// users would cost more than it explains.
  roles Json

  /// Set when a human disables the account. Sessions are revoked separately —
  /// this is the durable fact, the session store is the fast path.
  disabledAt DateTime? @map("disabled_at")

  /// Consecutive failed password attempts, and the time a lockout expires.
  /// Password-only admin (ADR-038) makes brute-force the whole attack surface,
  /// so the counter is durable rather than in-memory: restarting the API must
  /// not clear a lockout.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")

  /// Dev fixture marking (ADR-026, ADR-036).
  ///
  /// Users had no marker until dummy CUSTOMERS were seeded, and without one the
  /// boot guard could not see them: a contaminated production users table would
  /// have reported all clear. Customers are Users — a customer is simply an
  /// account with no admin or astrologer role — so this is the column that makes
  /// a synthetic customer detectable.
  isDevFixture   Boolean @default(false) @map("is_dev_fixture")
  fixtureDataset String? @map("fixture_dataset") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]

  /// An astrologer's profile, when this account is one. Optional on both sides:
  /// profiles are ADMIN-CREATED and exist before the practitioner has ever
  /// signed in (ADR-043).
  astrologer Astrologer?

  /// Bookings this account made as a CUSTOMER. A customer is a User with no
  /// roles (ADR-036); there is no separate table.
  bookings Booking[]

  /// What this account has agreed to, and which version of it (ADR-050).
  policyAcceptances PolicyAcceptance[]

  @@index([disabledAt])
  @@index([isDevFixture])
  @@index([fixtureDataset])
  @@map("users")
}

/// Server-side sessions (ADR-039, plan 3.2).
///
/// The reason this table exists rather than a self-contained token: revocation.
/// A signed token is valid until it expires, so disabling an account would not
/// end a live session. Revocation has to be a lookup against something the
/// server can change, which means a row.
///
/// The cookie carries a random id; only its SHA-256 lands here, so a dump of
/// this table does not let anyone resume a session.
model Session {
  /// SHA-256 of the cookie value, hex. Never the cookie value itself.
  tokenHash String @id @map("token_hash") @db.Char(64)

  userId String @map("user_id") @db.Char(26)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Recorded to show a person their own sessions, and to make a stolen cookie
  /// visible in the audit trail.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  expiresAt  DateTime  @map("expires_at")
  /// Set when revoked. Kept rather than deleted so "when did this end, and why"
  /// stays answerable; the scheduler purges rows well past expiry.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// An astrologer's public profile and commercial terms (ADR-043).
///
/// ADMIN-CREATED. There is no self-signup: at a roster of twelve or fewer, a
/// KYC pipeline costs more than it protects, so a person with admin rights
/// enters the profile and a human decides when it goes live.
model Astrologer {
  id String @id @db.Char(26) // ULID

  /// Linked when the practitioner first signs in. NULL until then, which is the
  /// normal state for a freshly created profile — the profile is the record,
  /// the account is just how they reach it.
  userId String? @unique @map("user_id") @db.Char(26)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Public URL segment. Stable once published: changing it breaks every link
  /// anyone has shared.
  slug String @unique @db.VarChar(80)

  /// Devanagari is canonical for display — the brand wheel labels every sign in
  /// it and none in Western glyphs — with a Latin transliteration alongside so
  /// the name is addressable in both scripts.
  nameHi String @map("name_hi") @db.VarChar(120)
  nameEn String @map("name_en") @db.VarChar(120)

  /// Also carries the company office for the founding directors — "Executive
  /// Director", "Director". A separate column for one label at a roster of
  /// three would be over-modelling; revisit if it ever needs to be filtered on.
  headline String? @db.VarChar(160)
  bio      String? @db.Text

  /// An integer, not a string. "20+ years" is a rendering decision, not data,
  /// and a string here cannot be sorted or validated.
  ///
  /// NULLABLE, and that is the point (ADR-044). The three founding directors
  /// are real, named and already public, but their years of practice have not
  /// been supplied (owner action O3). A required column here meant the real
  /// people could not be entered at all while twenty invented ones could —
  /// the model demanding data nobody has is the model being wrong.
  experienceYears Int? @map("experience_years")

  /// JSON arrays. MySQL has no array type, and join tables for languages and
  /// specialisations at a roster of twelve would cost more than they explain.
  /// Revisit when discovery and filtering land — both deferred past first
  /// revenue, which is exactly when a join table starts paying for itself.
  languages       Json
  specialisations Json

  /// INTEGER PAISE. Never rupees, never a float (ADR-019 / common/money.ts).
  ///
  /// This is the CURRENT rate and nothing else. A booking freezes its own price
  /// snapshot at creation and must never read back through this column — a rate
  /// change would otherwise silently rewrite the price of every past booking
  /// (§79, Phase 6).
  /// NULLABLE for the same reason as experienceYears. A profile with no rate is
  /// PUBLISHABLE but not BOOKABLE — it can be named on the site as a founding
  /// astrologer while the price is still an owner decision. Phase 6 enforces
  /// the second half: no rate, no booking.
  sessionRatePaise Int? @map("session_rate_paise")
  sessionMinutes   Int  @default(30) @map("session_minutes")

  /// PER-MINUTE rate for CHAT consultations (ADR-052). Integer paise.
  ///
  /// Separate from sessionRatePaise on purpose: voice is billed by the booked
  /// appointment and chat by the minute, so they are two different prices and
  /// one column could not hold both meanings. Null means this astrologer does
  /// not take chat consultations.
  chatRatePerMinutePaise Int? @map("chat_rate_per_minute_paise")

  /// The longest a chat consultation with this astrologer may run.
  ///
  /// A cap is not a preference. Per-minute billing cannot be collected at
  /// booking because the amount is unknown then, and with no wallet (ADR-023)
  /// the only alternative is authorising a maximum up front and capturing the
  /// actual — and an authorisation needs a number.
  chatMaxMinutes Int @default(30) @map("chat_max_minutes")

  /// Minutes left free AFTER each session (task 5.2).
  ///
  /// Not cosmetic: Phase 6's overrun policy needs somewhere for a consultation
  /// that runs long to go. Without a buffer the only options are cutting
  /// someone off mid-sentence or silently eating into the next booking, and
  /// the second is how a scheduled-appointment product turns into a queue.
  bufferMinutes Int @default(0) @map("buffer_minutes")

  /// An R2 object key, never a URL. The KYC and media buckets are private and
  /// links are signed at read time with a short TTL (ADR-042), so storing a URL
  /// would store something that stops working.
  photoKey String? @map("photo_key") @db.VarChar(255)

  /// NOTHING IS PUBLIC UNTIL A HUMAN PUBLISHES IT. Public pages are real or
  /// empty — never an invented practitioner (§13, ADR-036). A synthetic row can
  /// be published in development and still cannot appear in production, because
  /// the fixture guard refuses to serve fixtures under a production profile.
  publishedAt DateTime? @map("published_at")

  /// Retired rather than deleted: past bookings must keep pointing at a real
  /// row, and financial history is immutable (§79).
  retiredAt DateTime? @map("retired_at")

  /// Dev fixture marking (ADR-026) and the dataset that created it (ADR-036).
  isDevFixture   Boolean @default(false) @map("is_dev_fixture")
  fixtureDataset String? @map("fixture_dataset") @db.VarChar(64)

  availabilityRules  AvailabilityRule[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@index([retiredAt])
  @@index([isDevFixture])
  @@index([fixtureDataset])
  @@map("astrologers")
}

/// A recurring weekly window an astrologer works (task 5.1).
///
/// STORED IN Asia/Kolkata WALL-CLOCK, deliberately, per task 6.5. "I work
/// Tuesdays 09:00–13:00" is a statement about local time that stays true
/// whatever happens elsewhere; storing it as a UTC instant would make it a
/// different claim every time some other country changed its clocks.
///
/// India has no DST and has not since 1945, so IST is a fixed +05:30 and the
/// conversion to UTC is exact arithmetic rather than a lookup. THAT IS AN
/// ASSUMPTION ABOUT INDIA, not about time: an astrologer in a DST-observing
/// country would need a real timezone library and a zone id on this row.
model AvailabilityRule {
  id String @id @db.Char(26) // ULID

  astrologerId String     @map("astrologer_id") @db.Char(26)
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's getDay().
  weekday Int @db.TinyInt

  /// Minutes from midnight IST. 540 = 09:00, 780 = 13:00.
  ///
  /// Integers rather than a TIME column: they compare and sort without any
  /// question of what zone the value is in, and a TIME column next to a
  /// DATETIME invites reading one as if it carried the other's zone.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// MySQL HAS NO EXCLUSION CONSTRAINTS, so overlapping windows cannot be
  /// forbidden by the schema — the service checks. Same class of gap as the
  /// partial-unique-index problem in ADR-029: the database will happily store
  /// something the domain forbids, so the check has to live somewhere and be
  /// tested.
  @@index([astrologerId, weekday])
  @@map("availability_rules")
}

/// A one-off period an astrologer is NOT available (task 5.1).
///
/// UTC INSTANTS, unlike the weekly rule above, and the difference matters: a
/// block is a real interval in the world ("I am at a wedding from Friday
/// evening to Sunday night"), not a statement about local clock time.
model AvailabilityBlock {
  id String @id @db.Char(26) // ULID

  astrologerId String     @map("astrologer_id") @db.Char(26)
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// Shown to nobody but the astrologer and an admin. A customer sees a slot
  /// that is not offered, never the reason.
  reason String? @db.VarChar(160)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([astrologerId, startsAt])
  @@map("availability_blocks")
}

/// A booked consultation slot (ADR-046).
///
/// THE SLOT IS HELD BY THIS ROW, not by Redis (ADR-029). A hold must outlive
/// the entire Razorpay flow, and a UPI collect request pends for minutes —
/// long enough that any sensible cache TTL would expire mid-payment and sell
/// the slot twice. Redis may cache this for the UI; it may never own it.
model Booking {
  id String @id @db.Char(26) // ULID

  astrologerId String     @map("astrologer_id") @db.Char(26)
  /// onUpdate: NoAction is REQUIRED, not a preference. MySQL refuses a foreign
  /// key with CASCADE on a column that feeds a STORED GENERATED column, and
  /// astrologer_id feeds slot_key — the CREATE fails with error 1215. Costs
  /// nothing: ULIDs are never updated.
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onUpdate: NoAction)

  customerId String @map("customer_id") @db.Char(26)
  customer   User   @relation(fields: [customerId], references: [id])

  /// UTC instants (task 6.5). The astrologer's availability RULE is IST
  /// wall-clock; the booked slot is a moment in the world.
  slotStart DateTime @map("slot_start")
  slotEnd   DateTime @map("slot_end")

  /// voice · chat. Chosen at BOOKING, because it decides which price snapshot
  /// is taken — voice freezes an amount, chat freezes an authorised ceiling and
  /// a per-minute rate (ADR-052). Consultation.modality says the same thing
  /// about the session that actually happened; this says what was sold.
  ///
  /// Deliberately NOT derived from `chatRatePerMinutePaise == null`: that trick
  /// works until someone stores a rate on a voice booking for reference, and
  /// then every reader of the table is quietly wrong.
  modality String @default("voice") @db.VarChar(8)

  /// held · confirmed · cancelled · expired · completed · no_show
  status String @db.VarChar(16)

  /// THE SLOT-OCCUPANCY KEY — a STORED GENERATED COLUMN, created by raw SQL in
  /// the migration because Prisma cannot express one.
  ///
  /// NULL when the row does not occupy its slot, otherwise
  /// `astrologer_id + '#' + slot_start`. MySQL permits unlimited NULLs in a
  /// unique index, so a unique index on this yields exactly the filtered
  /// uniqueness MySQL's lack of partial indexes otherwise denies (ADR-029).
  ///
  /// A plain UNIQUE(astrologer_id, slot_start) — the PostgreSQL habit — would
  /// block that slot FOR EVER after one cancellation, and would surface as
  /// astrologers asking why their afternoons vanished.
  ///
  /// NEVER WRITTEN BY THE APPLICATION. MySQL computes it.
  slotKey String? @map("slot_key") @db.VarChar(64)

  /// PRICE SNAPSHOT, frozen at creation and never recomputed (§79). Reading
  /// the price back through astrologers.session_rate_paise would rewrite the
  /// price of every past booking the moment someone edits a rate.
  ///
  /// FOR A VOICE BOOKING this is the amount charged, known at booking.
  /// FOR A CHAT BOOKING it is the AUTHORISED CEILING — the most the customer
  /// can be charged — and the amount actually captured is computed from the
  /// meter when the consultation ends (ADR-052). The two are the same number
  /// only when a chat runs to its maximum.
  pricePaise     Int @map("price_paise")
  sessionMinutes Int @map("session_minutes")

  /// The per-minute rate in force when this chat booking was made, frozen like
  /// every other price (§79). Null for a voice booking.
  chatRatePerMinutePaise Int? @map("chat_rate_per_minute_paise")

  /// What was actually charged once the meter stopped. Null until then, and
  /// null for ever on a voice booking, where pricePaise is already the answer.
  capturedPaise Int? @map("captured_paise")

  /// The gateway's order id — created when the customer starts checkout, and
  /// the only thread tying Razorpay's record to ours. UNIQUE: one order belongs
  /// to exactly one booking, or a bug that reused an order would confirm
  /// whichever booking the webhook happened to find first.
  razorpayOrderId String? @unique @map("razorpay_order_id") @db.VarChar(64)

  /// The payment that paid for it. UNIQUE so that a replayed webhook cannot
  /// apply twice even if the event-id deduplication fails — the database says
  /// it independently of the application.
  razorpayPaymentId String? @unique @map("razorpay_payment_id") @db.VarChar(64)

  /// TAX COLUMNS, present from THIS migration deliberately (task 6.4).
  ///
  /// Under pay-at-booking the invoice is issued at booking, and adding a tax
  /// split to already-paid rows is the uncorrectable retrofit the plan exists
  /// to avoid. They are NULLABLE only because the rate is unanswered (owner
  /// action O6: is Stella principal or agent for GST?). Phase 7 computes them
  /// and a booking cannot be CONFIRMED without them — an unpaid held row may
  /// carry nulls; a paid one may not.
  taxableValuePaise Int?    @map("taxable_value_paise")
  /// Basis points: 1800 = 18%. An integer, because a percentage as a float is
  /// the same mistake as rupees as a float.
  taxRateBp         Int?    @map("tax_rate_bp")
  taxAmountPaise    Int?    @map("tax_amount_paise")
  sacCode           String? @map("sac_code") @db.VarChar(16)
  placeOfSupply     String? @map("place_of_supply") @db.VarChar(2)

  /// When an unconfirmed hold lapses. The generated column cannot reference
  /// NOW(), so expiry is MATERIALISED by the reaper flipping status — which is
  /// what makes the hold durable rather than a clock the database consults.
  holdExpiresAt DateTime? @map("hold_expires_at")

  confirmedAt DateTime? @map("confirmed_at")
  cancelledAt DateTime? @map("cancelled_at")

  /// customer · astrologer · admin · system. The refund policy turns on this:
  /// a customer cancelling ninety minutes ahead and an astrologer cancelling
  /// ninety seconds ahead must never be the same refund.
  cancelledBy  String? @map("cancelled_by") @db.VarChar(16)
  cancelReason String? @map("cancel_reason") @db.VarChar(200)

  /// How many times this booking has been moved (task 6.6). A reschedule moves
  /// THIS row rather than creating a second one, so without a counter the
  /// history lives only in the audit log — which is the wrong place to enforce
  /// a limit from, on the request path.
  rescheduleCount Int @default(0) @map("reschedule_count")

  /// One key, one booking (task 6.3). A double-click creating two Razorpay
  /// orders for one slot is the most likely launch incident: the unique index
  /// on slot_key protects the SLOT, this protects the CUSTOMER'S CARD.
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consultation Consultation?

  @@index([astrologerId, slotStart])
  @@index([customerId])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

/// The session itself — one per booking (ADR-048).
model Consultation {
  id String @id @db.Char(26) // ULID

  bookingId String  @unique @map("booking_id") @db.Char(26)
  booking   Booking @relation(fields: [bookingId], references: [id], onUpdate: NoAction)

  /// 'voice' or 'chat' (ADR-051). Fixed when the booking is made, because the
  /// customer chose and paid for one or the other.
  modality String @default("voice") @db.VarChar(8)

  /// The 100ms room, created per consultation. Never a shared room (ADR-047).
  /// Null for a chat consultation — there is no call to join.
  roomId String? @map("room_id") @db.VarChar(64)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// Join/leave is the only honest no-show signal (task 6.8).
  astrologerJoinedAt DateTime? @map("astrologer_joined_at")
  customerJoinedAt   DateTime? @map("customer_joined_at")

  /// ── Chat metering (ADR-052) ────────────────────────────────────
  /// Null for a voice consultation, which is billed by the appointment.

  /// When the meter started: the ASTROLOGER'S FIRST MESSAGE, not the appointed
  /// time and not when the customer opened the chat. A customer waiting for the
  /// astrologer to appear is not receiving a consultation.
  meterStartedAt DateTime? @map("meter_started_at")
  meterStoppedAt DateTime? @map("meter_stopped_at")

  /// Seconds actually charged, after excluding silence beyond the grace period.
  /// Stored in SECONDS and rounded to minutes only when charging, so the
  /// rounding happens once and can be re-checked against this number.
  billableSeconds     Int? @map("billable_seconds")
  /// Silence that was NOT charged. Kept so a billing query can be answered
  /// with "you were charged for X and not for Y" rather than a bare total.
  idleSecondsExcluded Int? @map("idle_seconds_excluded")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consents  RecordingConsent[]
  recording Recording?
  messages  ChatMessage[]

  /// One review queue for both modalities (ADR-051).
  assessment ConsultationAssessment?

  @@map("consultations")
}

/// One party's consent to being recorded (ADR-048).
///
/// A ROW PER PARTY, not a boolean on the consultation. Recording needs BOTH,
/// and a single flag cannot say who agreed to what — which is the only thing
/// that matters if it is ever questioned.
///
/// Stored as an artifact with a policy version and a timestamp, the same shape
/// as lead consent: "they agreed" without a record of what they agreed to is
/// not consent.
model RecordingConsent {
  id String @id @db.Char(26)

  consultationId String       @map("consultation_id") @db.Char(26)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  /// 'astrologer' or 'customer'.
  party String @db.VarChar(16)

  /// The account that answered. Kept so a later question has an answer.
  userId String @map("user_id") @db.Char(26)

  /// TRUE is consent, FALSE is refusal, and a refusal is recorded rather than
  /// treated as an absent answer. "They never replied" and "they said no" are
  /// different facts and only one of them is a decision.
  granted Boolean

  /// What they were shown. Without this, consent cannot be demonstrated.
  policyVersion String   @map("policy_version") @db.VarChar(32)
  decidedAt     DateTime @map("decided_at")

  /// Set when withdrawn. Withdrawal deletes the recording; this row stays as
  /// the record that it was withdrawn and when.
  withdrawnAt DateTime? @map("withdrawn_at")

  @@unique([consultationId, party])
  @@index([userId])
  @@map("recording_consents")
}

/// A stored audio recording (ADR-048).
model Recording {
  id String @id @db.Char(26)

  consultationId String       @unique @map("consultation_id") @db.Char(26)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  /// The R2 object key in `stella-recordings`. NEVER a URL: the bucket is
  /// private and links are signed at read time with a short TTL (ADR-042).
  objectKey String? @map("object_key") @db.VarChar(255)

  durationSeconds Int? @map("duration_seconds")
  sizeBytes       Int? @map("size_bytes")

  /// pending · stored · failed · deleted
  status String @db.VarChar(16)

  /// When R2's own lifecycle rule will remove the object. Recorded so the
  /// database agrees with the bucket rather than guessing at it.
  expiresAt DateTime? @map("expires_at")

  /// Set when removed before expiry — a withdrawn consent or a DPDP erasure.
  deletedAt     DateTime? @map("deleted_at")
  deletedReason String?   @map("deleted_reason") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@map("recordings")
}

/// A machine assessment of a recording, and its human review (ADR-048).
///
/// THE WHOLE POINT OF THIS TABLE IS THE REVIEW GATE. Automated analysis over
/// Hindi and regional languages will produce false positives, and telling an
/// astrologer that software judged them abusive is defamatory when it is wrong.
/// So a machine result is a DRAFT until a named person has listened.
model ConsultationAssessment {
  id String @id @db.Char(26)

  /// THE SUBJECT IS THE CONSULTATION, not the artifact.
  ///
  /// Renamed from RecordingAssessment when chat landed: a chat consultation has
  /// a transcript rather than a recording, and it needs exactly the same review
  /// gate. Keying the queue to `Recording` would have meant a second, parallel
  /// pipeline for chat — and a second place for the "a machine result is a
  /// draft" rule to be forgotten.
  consultationId String       @unique @map("consultation_id") @db.Char(26)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  /// pending · machine_done · under_review · published · dismissed
  ///
  /// Only `published` is visible to the astrologer. Nothing reaches them
  /// straight from the machine.
  status String @db.VarChar(16)

  /// What the machine thought. Advisory, never a finding.
  abuseFlagged    Boolean @default(false) @map("abuse_flagged")
  /// 0–100. Kept as an integer; a confidence as a float invites false
  /// precision in a number that is already a guess.
  abuseConfidence Int?    @map("abuse_confidence")
  machineNotes    String? @map("machine_notes") @db.Text

  /// The reviewer's decision. Set only by a human.
  ///
  /// The reviewer MAY NOT be the astrologer being assessed — enforced in the
  /// service, because at roster 3 they are otherwise the only available
  /// reviewer (the four-eyes gap in task 6.9 / owner action O5).
  reviewerId      String?   @map("reviewer_id") @db.Char(26)
  reviewedAt      DateTime? @map("reviewed_at")
  reviewerVerdict String?   @map("reviewer_verdict") @db.VarChar(16)
  reviewerNotes   String?   @map("reviewer_notes") @db.Text

  /// Published grade, 1–5. Null until a human publishes it.
  grade Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("consultation_assessments")
}

/// One message in a chat consultation (ADR-051).
///
/// The transcript IS the consultation record, in the way an audio file is for a
/// voice call — so it carries the same retention, the same review path and the
/// same erasure obligations. A chat consultation cannot happen without this
/// being stored, which is why clause 10 of the Terms says so plainly rather
/// than asking for a consent that could not be declined.
model ChatMessage {
  id String @id @db.Char(26) // ULID, so ordering is the insertion order

  consultationId String       @map("consultation_id") @db.Char(26)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  /// 'astrologer' or 'customer'. Never 'system' or 'bot': the Terms state that
  /// a customer is writing to a named human, and a machine-authored message in
  /// this table would make that false.
  sender String @db.VarChar(16)

  /// The account that sent it, so authorship survives a display-name change.
  senderUserId String @map("sender_user_id") @db.Char(26)

  body String @db.Text

  sentAt DateTime @map("sent_at")

  /// Cleared on erasure or when retention expires. The ROW stays so the
  /// transcript's shape — who sent how many, and when — remains answerable
  /// without the content.
  redactedAt DateTime? @map("redacted_at")

  @@index([consultationId, sentAt])
  @@map("chat_messages")
}

/// A recorded acceptance of one policy, at one version (ADR-050).
///
/// Owner decision, 2026-09-15: the terms are shown as an ITEMISED LIST before
/// an account is created, and recording is one of the listed points.
///
/// A ROW PER POLICY, not a single "accepted the terms" flag. DPDP consent must
/// be specific, and one boolean covering terms, privacy and being recorded
/// cannot show which of them a person actually agreed to. It also means a
/// policy can be revised without re-asking for the others.
///
/// The VERSION is the point. "They accepted" is worthless a year later if
/// nobody can say what the text said; this row plus the archived text is the
/// whole of the evidence.
model PolicyAcceptance {
  id String @id @db.Char(26) // ULID

  userId String @map("user_id") @db.Char(26)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'terms' · 'privacy' · 'recording'
  policy String @db.VarChar(32)

  /// The exact version shown. Never a date, never "latest".
  version String @db.VarChar(32)

  /// FALSE is a refusal and is stored. Someone who declined recording is not
  /// the same as someone who was never asked, and only one of them is a
  /// decision that can be relied on.
  accepted Boolean

  acceptedAt DateTime @map("accepted_at")

  /// Evidence of the circumstances, same as the waitlist consent record.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  /// Set when the person later changes their mind.
  withdrawnAt DateTime? @map("withdrawn_at")

  @@unique([userId, policy, version])
  @@index([userId, policy])
  @@map("policy_acceptances")
}
