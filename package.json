{
  "name": "stella-astrology",
  "version": "0.0.0",
  "private": true,
  "description": "Astrology consultation marketplace for India. Scheduled bookings, web-only V1.",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build:assets": "node scripts/build-assets.mjs",
    "build": "npm run build:assets && npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gate:contrast": "node scripts/contrast-lint.mjs",
    "gate:i18n": "node scripts/i18n-parity.mjs",
    "gate:fixtures": "node scripts/no-fixtures-in-prod.mjs",
    "gates": "npm run gate:contrast && npm run gate:i18n && npm run gate:fixtures"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@swc/core": "^1.16.2",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  }
}
