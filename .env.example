# ===========================================================================
# STELLA ASTROLOGY — environment template
# ===========================================================================
# Copy to .env and fill from /home/stellaastro/secrets/config.txt
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real values to this file.
# Separate values are required per environment (development / staging /
# production) per system_architecture Part XXVI — never share keys across them.
# ===========================================================================

NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Database (MySQL 8) ----------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME_shadow"
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE

# --- Redis / RabbitMQ ------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://127.0.0.1:5672

# --- Firebase Authentication ----------------------------------------------
# Public config (safe for client bundles)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Server-side Admin SDK — path to a gitignored service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=/home/stellaastro/secrets/firebase-adminsdk.json

# --- Astrology provider (ADR-004: ProKerala primary) -----------------------
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
PROKERALA_BASE_URL=https://api.prokerala.com
# Secondary adapter, used for cross-checks only
ASTROLOGYAPI_KEY=
ASTROLOGY_ENGINE_VERSION=v1
ASTROLOGY_AYANAMSA=lahiri

# --- Payments: Razorpay (ADR-006: non-refundable service credit) -----------
# NEVER put live keys in a development .env. Use rzp_test_* locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_ID=
# Payouts (RazorpayX — separate onboarding from the payments account)
RAZORPAYX_ACCOUNT_NUMBER=

# --- Realtime: 100ms (ADR-005) --------------------------------------------
HMS_APP_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=
HMS_SUBDOMAIN=
# Recording is NOT enabled in V1 (ADR-015) — seam kept for later
HMS_RECORDING_ENABLED=false

# --- Object storage: Cloudflare R2, S3-compatible (ADR-014) ---------------
# Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com. R2's region is
# always 'auto'; empty and us-east-1 alias to it, so leave S3_REGION alone.
#
# BACKUPS DO NOT READ THIS FILE. Their configuration lives in
# /home/stellaastro/secrets/backup.env, outside the docroot and outside any git
# working tree — see infrastructure/backup/. The keys are duplicated here only
# so a developer can see the shape.
S3_ACCOUNT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_KYC=stella-kyc
S3_BUCKET_BACKUPS=stella-backups

# Encrypts the secrets archive before it leaves the machine. Generate with
# `openssl rand -base64 36`. Keep a copy in a password manager OFF the server:
# it lives in the directory it protects, so losing the box loses both.
BACKUP_ENCRYPTION_PASSPHRASE=
S3_BUCKET_REPORTS=stella-reports
S3_BUCKET_UPLOADS=stella-uploads
# All buckets private; access only via short-lived signed URLs (rough_plan §31)
S3_SIGNED_URL_TTL_SECONDS=300

# --- AI provider abstraction (rough_plan §32) ------------------------------
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- Monitoring ------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# --- Email / SMS / WhatsApp ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Application security --------------------------------------------------
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
# i18n (ADR-012): auto-detect, Hindi default in India
DEFAULT_LOCALE=hi
FALLBACK_LOCALE=en
SUPPORTED_LOCALES=hi,en

# ── Added 2026-09-06 ────────────────────────────────────────────
# Runtime ports and public URL
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
WEB_PORT=3000
PUBLIC_BASE_URL=https://www.stellaastro.com

# Cloudflare Turnstile — protects the public waitlist endpoint.
# The endpoint degrades OPEN if Turnstile is unreachable: a bot-check outage
# must not take the only signup path down. Bypassed leads are flagged.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth (ADR-037). Create a Web application client in Google Cloud
# Console and add the redirect URI below to its Authorised redirect URIs.
# The Firebase NEXT_PUBLIC_FIREBASE_* keys above are DEAD — ADR-037 dropped
# Firebase when phone OTP was dropped.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.stellaastro.com/api/v1/auth/google/callback
